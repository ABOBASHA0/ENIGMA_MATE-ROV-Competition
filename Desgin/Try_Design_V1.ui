  <property name="windowTitle">
   <string>MainWindow</string>
  </property>
  <property name="styleSheet">
   <string notr="true">/* =========================================================
   ENIGMA ROV
   MODERN ROUNDED DARK THEME
   Black + Deep Blue + Orange
   ========================================================= */


/* =========================================================
   GLOBAL
   ========================================================= */

QWidget {
    background-color: #000000;
    color: #FFFFFF;
    font-family: &quot;Segoe UI&quot;;
}


/* =========================================================
   MAIN WINDOW
   ========================================================= */

QMainWindow {
    background-color: #000000;
}

QMainWindow &gt; QWidget {
    background-color: #000000;
}


/* =========================================================
   FRAMES / HOLDERS
   ========================================================= */

/* Default frame */

QFrame {
    background-color: #000000;
    border: 1px solid #14213D;
    border-radius: 8px;
}


/* Main holder */

QFrame#holderFrame {
    background-color: #0D0D0D;
    border: 1px solid #14213D;
    border-radius: 12px;
}


/* Control holder */

QFrame#controlFrame {
    background-color: #0D0D0D;
    border: 1px solid #14213D;
    border-radius: 12px;
}


/* Main content frame */

QFrame#mainFrame {
    background-color: #000000;
    border: 1px solid #14213D;
    border-radius: 12px;
}


/* =========================================================
   LABELS
   ========================================================= */

QLabel {
    background-color: transparent;
    border: 0px;
    color: #FFFFFF;
}


/* Secondary label */

QLabel#secondaryLabel {
    color: #E5E5E5;
}


/* Orange label */

QLabel#accentLabel {
    color: #FCA311;
    font-weight: bold;
}


/* =========================================================
   BUTTONS
   ========================================================= */

QPushButton {
    background-color: #0D0D0D;
    color: #FFFFFF;

    border: 1px solid #14213D;
    border-radius: 8px;

    padding: 7px 12px;
}

QPushButton:hover {
    background-color: #14213D;
    border: 1px solid #FCA311;
    color: #FFFFFF;
}

QPushButton:pressed {
    background-color: #FCA311;
    border: 1px solid #FCA311;
    color: #000000;
}

QPushButton:checked {
    background-color: #FCA311;
    border: 1px solid #FCA311;
    color: #000000;
}


/* Primary button */

QPushButton#primaryButton {
    background-color: #FCA311;
    color: #000000;

    border: 1px solid #FCA311;
    border-radius: 8px;

    font-weight: bold;
}

QPushButton#primaryButton:hover {
    background-color: #FFFFFF;
    border: 1px solid #FFFFFF;
    color: #000000;
}

QPushButton#primaryButton:pressed {
    background-color: #E5E5E5;
}


/* =========================================================
   COMBO BOX
   ========================================================= */

QComboBox {
    background-color: #0D0D0D;
    color: #FFFFFF;

    border: 1px solid #14213D;
    border-radius: 8px;

    padding: 6px 10px;
}

QComboBox:hover {
    border: 1px solid #FCA311;
}

QComboBox:focus {
    border: 1px solid #FCA311;
}


/* Combo arrow area */

QComboBox::drop-down {
    background-color: transparent;
    border: 0px;
    width: 24px;
}


/* Combo popup */

QComboBox QAbstractItemView {
    background-color: #0D0D0D;
    color: #FFFFFF;

    border: 1px solid #14213D;

    selection-background-color: #FCA311;
    selection-color: #000000;
}


/* =========================================================
   TABS
   ========================================================= */

QTabWidget::pane {
    background-color: #000000;

    border: 1px solid #14213D;
    border-radius: 10px;
}


/* Tab */

QTabBar::tab {
    background-color: #0D0D0D;
    color: #E5E5E5;

    border: 1px solid #14213D;
    border-radius: 7px;

    padding: 8px 17px;

    margin: 2px;
}


/* Tab hover */

QTabBar::tab:hover {
    background-color: #14213D;
    color: #FFFFFF;

    border: 1px solid #FCA311;
}


/* Selected tab */

QTabBar::tab:selected {
    background-color: #000000;
    color: #FFFFFF;

    border: 1px solid #14213D;
    border-bottom: 3px solid #FCA311;

    border-radius: 7px;
}


/* =========================================================
   LINE EDIT
   ========================================================= */

QLineEdit {
    background-color: #0D0D0D;
    color: #FFFFFF;

    border: 1px solid #14213D;
    border-radius: 8px;

    padding: 7px;
}

QLineEdit:hover {
    border: 1px solid #FCA311;
}

QLineEdit:focus {
    border: 1px solid #FCA311;
}


/* =========================================================
   TEXT EDIT
   ========================================================= */

QTextEdit {
    background-color: #0D0D0D;
    color: #FFFFFF;

    border: 1px solid #14213D;
    border-radius: 9px;

    padding: 5px;
}

QTextEdit:focus {
    border: 1px solid #FCA311;
}


QPlainTextEdit {
    background-color: #0D0D0D;
    color: #FFFFFF;

    border: 1px solid #14213D;
    border-radius: 9px;

    padding: 5px;
}

QPlainTextEdit:focus {
    border: 1px solid #FCA311;
}


/* =========================================================
   TABLE
   ========================================================= */

QTableWidget {
    background-color: #000000;
    color: #FFFFFF;

    alternate-background-color: #080808;

    border: 1px solid #14213D;
    border-radius: 9px;

    gridline-color: #14213D;
}


/* Table items */

QTableWidget::item {
    padding: 5px;
}


/* Selected item */

QTableWidget::item:selected {
    background-color: #FCA311;
    color: #000000;
}


/* =========================================================
   TABLE HEADER
   ========================================================= */

QHeaderView {
    background-color: #0D0D0D;
    border: 0px;
}


QHeaderView::section {
    background-color: #0D0D0D;
    color: #E5E5E5;

    border: 0px;
    border-bottom: 1px solid #14213D;

    padding: 8px;
}


/* =========================================================
   GROUP BOX
   ========================================================= */

QGroupBox {
    background-color: #000000;
    color: #FFFFFF;

    border: 1px solid #14213D;
    border-radius: 10px;

    margin-top: 12px;
    padding-top: 8px;
}


QGroupBox::title {
    subcontrol-origin: margin;

    left: 12px;

    padding: 0px 7px;

    background-color: #000000;
    color: #FCA311;
}


/* =========================================================
   CHECK BOX
   ========================================================= */

QCheckBox {
    background-color: transparent;
    color: #FFFFFF;

    border: 0px;

    spacing: 8px;
}


QCheckBox::indicator {
    width: 16px;
    height: 16px;
}


QCheckBox::indicator:unchecked {
    background-color: #0D0D0D;

    border: 1px solid #14213D;
    border-radius: 5px;
}


QCheckBox::indicator:checked {
    background-color: #FCA311;

    border: 1px solid #FCA311;
    border-radius: 5px;
}


/* =========================================================
   RADIO BUTTON
   ========================================================= */

QRadioButton {
    background-color: transparent;
    color: #FFFFFF;

    border: 0px;
}


QRadioButton::indicator {
    width: 16px;
    height: 16px;
}


QRadioButton::indicator:unchecked {
    background-color: #0D0D0D;

    border: 1px solid #14213D;
    border-radius: 8px;
}


QRadioButton::indicator:checked {
    background-color: #FCA311;

    border: 2px solid #FCA311;
    border-radius: 8px;
}


/* =========================================================
   SLIDER
   ========================================================= */

QSlider::groove:horizontal {
    background-color: #14213D;

    height: 5px;
    border-radius: 2px;
}


QSlider::sub-page:horizontal {
    background-color: #FCA311;

    height: 5px;
    border-radius: 2px;
}


QSlider::add-page:horizontal {
    background-color: #111111;

    height: 5px;
    border-radius: 2px;
}


QSlider::handle:horizontal {
    background-color: #FCA311;

    width: 15px;
    height: 15px;

    margin: -5px 0px;

    border-radius: 7px;
}


QSlider::handle:horizontal:hover {
    background-color: #FFFFFF;
}


/* =========================================================
   PROGRESS BAR
   ========================================================= */

QProgressBar {
    background-color: #0D0D0D;
    color: #FFFFFF;

    border: 1px solid #14213D;
    border-radius: 8px;

    text-align: center;
}


QProgressBar::chunk {
    background-color: #FCA311;
    border-radius: 7px;
}


/* =========================================================
   SCROLL BAR
   ========================================================= */

QScrollBar:vertical {
    background-color: #000000;

    width: 10px;

    border: 0px;
}


QScrollBar::handle:vertical {
    background-color: #14213D;

    min-height: 25px;

    border-radius: 5px;
}


QScrollBar::handle:vertical:hover {
    background-color: #FCA311;
}


QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}


/* Horizontal scrollbar */

QScrollBar:horizontal {
    background-color: #000000;

    height: 10px;

    border: 0px;
}


QScrollBar::handle:horizontal {
    background-color: #14213D;

    min-width: 25px;

    border-radius: 5px;
}


QScrollBar::handle:horizontal:hover {
    background-color: #FCA311;
}


QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}


/* =========================================================
   TOOLTIP
   ========================================================= */

QToolTip {
    background-color: #0D0D0D;
    color: #FFFFFF;

    border: 1px solid #FCA311;

    padding: 6px;
}


/* =========================================================
   MENU
   ========================================================= */

QMenu {
    background-color: #0D0D0D;
    color: #FFFFFF;

    border: 1px solid #14213D;
}


QMenu::item {
    padding: 7px 20px;
}


QMenu::item:selected {
    background-color: #FCA311;
    color: #000000;
}


/* =========================================================
   STATUS BAR
   ========================================================= */

QStatusBar {
    background-color: #0D0D0D;
    color: #E5E5E5;

    border-top: 1px solid #14213D;
}
/* =========================================================
   WEB VIEWER
   ========================================================= */

QWebEngineView {
    background-color: #000000;

    border: 1px solid #14213D;
    border-radius: 12px;
}</string>
